@model CrudNet8MVC.Models.Libro
@{
    ViewData["Title"] = "Borrar libro";
}

<h1 class="text-center">Libro con .net8(.NET Core MVC)</h1>

<div class="row">
    <div class="offset-12">
        <div class="card border">
            <div class="card-header bg-dark">
                <h3 class="text-white"><strong>Borrar Libro</strong></h3>
            </div>
            <div class=" card-body">

                <form asp-action="Borrar" method="post">

                    @* ID DEL LIBRO COMO CAMPO OCULTO *@

                    <input type="hidden" asp-for="Id" />

                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="form-group">
                        <label asp-for="Isbn" class="control-label"></label>
                        <input asp-for="Isbn" class="form-control" readonly />
                        <span asp-validation-for="Isbn" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Titulo" class="control-label"></label>
                        <input asp-for="Titulo" class="form-control" readonly />
                        <span asp-validation-for="Titulo" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Autor" class="control-label"></label>
                        <input asp-for="Autor" class="form-control" readonly />
                        <span asp-validation-for="Autor" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Editorial" class="control-label"></label>
                        <input asp-for="Editorial" class="form-control" readonly />
                        <span asp-validation-for="Editorial" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Genero" class="control-label"></label>
                        <input asp-for="Genero" class="form-control" readonly />
                        <span asp-validation-for="Genero" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Anio" class="control-label"></label>
                        <input asp-for="Anio" class="form-control" readonly />
                        <span asp-validation-for="Anio" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Cantidad" class="control-label"></label>
                        <input asp-for="Cantidad" class="form-control" readonly />
                        <span asp-validation-for="Cantidad" class="text-danger"></span>
                    </div>

                    <div class="form-group mt-3">
                        <button type="submit" class="btn btn-danger d-block mx-auto"><i class="fa-solid fa-book"></i> Borrar Libro</button>
                    </div>
                </form>

                <a asp-controller="Inicio" asp-action="Index">Volver</a>
            </div>
        </div>
    </div>
</div>