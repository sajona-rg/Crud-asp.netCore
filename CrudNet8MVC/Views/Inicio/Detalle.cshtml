@model CrudNet8MVC.Models.Contact
@{
    ViewData["Title"] = "Detalle contacto";
}

<h1 class="text-center">Contacto con .net8(.NET Core MVC)</h1>

<div class="row">
    <div class="offset-12">
        <div class="card border">
            <div class="card-header bg-dark">
                <h3 class="text-white"><strong>Detalle Usuario</strong></h3>
            </div>
            <div class=" card-body">

                <ul class="list-group">
                    <list class="list-group-item"><strong>Nombre:</strong>@Html.DisplayFor(m => m.Name)</list>
                    <list class="list-group-item"><strong>Celular:</strong>@Html.DisplayFor(m => m.CellPhone)</list>
                    <list class="list-group-item"><strong>Telefono:</strong>@Html.DisplayFor(m => m.HomePhone)</list>
                    <list class="list-group-item"><strong>Email:</strong>@Html.DisplayFor(m => m.Email)</list>
                    <list class="list-group-item"><strong>Fecha:</strong>@Html.DisplayFor(m => m.FechaCreacion)</list>
                </ul>

                <a asp-controller="Inicio" asp-action="Index">Volver</a>
            </div>
        </div>
    </div>
</div>

